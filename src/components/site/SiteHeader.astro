---
import { REPO_ROOT } from '../../lib/github';
import { SITE_NAME, withBasePath } from '../../lib/site';

const homeHref = withBasePath(import.meta.env.BASE_URL);
const aboutHref = withBasePath(import.meta.env.BASE_URL, 'about/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homeHref}>
      <!-- Pen-nib icon -->
      <svg
        class="brand-icon"
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M13 2L16 5L7 14L3 15L4 11L13 2Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
          fill="none"
        />
        <path
          d="M11 4L14 7"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          d="M4 11L7 14"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          opacity="0.5"
        />
      </svg>
      {SITE_NAME}
    </a>

    <div class="site-header__right">
      <nav class="site-header__nav" aria-label="Primary">
        <a href={homeHref}>Home</a>
        <a href={aboutHref}>About</a>
        <a href={REPO_ROOT} target="_blank" rel="noreferrer">GitHub</a>
      </nav>

      <!-- Dark mode toggle -->
      <button
        class="theme-toggle"
        data-theme-toggle
        type="button"
        aria-label="Toggle dark mode"
      >
        <!-- Sun icon (shown in dark mode to switch to light) -->
        <svg
          class="theme-toggle__sun"
          width="17"
          height="17"
          viewBox="0 0 17 17"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="8.5" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"/>
          <path
            d="M8.5 1.5V3M8.5 14V15.5M1.5 8.5H3M14 8.5H15.5M3.7 3.7L4.8 4.8M12.2 12.2L13.3 13.3M3.7 13.3L4.8 12.2M12.2 4.8L13.3 3.7"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
        <!-- Moon icon (shown in light mode to switch to dark) -->
        <svg
          class="theme-toggle__moon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M13.5 9.5A6 6 0 1 1 6.5 2.5a4.5 4.5 0 0 0 7 7z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
            fill="none"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    window.__toggleTheme?.();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-elevated);
    border-bottom: 1px solid var(--surface-border);
    transition:
      background-color 380ms ease,
      border-color 380ms ease;
  }

  .site-header__inner {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--ink-black);
    text-decoration: none;
    transition: color var(--transition-base), opacity var(--transition-base);
  }

  .site-header__brand:hover {
    color: var(--ink-blue);
    opacity: 1;
  }

  .brand-icon {
    color: var(--ink-blue);
    flex-shrink: 0;
    transition: color var(--transition-base);
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__nav {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .site-header__nav a {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-black-soft);
    text-decoration: none;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    transition:
      color var(--transition-base),
      background-color var(--transition-base);
  }

  .site-header__nav a:hover {
    color: var(--ink-blue);
    background: var(--ink-blue-wash);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--surface-border-strong);
    border-radius: var(--radius-sm);
    color: var(--ink-black-soft);
    cursor: pointer;
    transition:
      color var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--ink-blue);
    background: var(--ink-blue-wash);
    border-color: var(--ink-blue);
  }

  /* Sun = visible in dark mode (click to go light) */
  .theme-toggle__sun {
    display: none;
  }

  .theme-toggle__moon {
    display: block;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: block;
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    display: none;
  }

  /* Handle system dark preference before JS sets data-theme */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle__sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme-toggle__moon {
      display: none;
    }
  }
</style>
